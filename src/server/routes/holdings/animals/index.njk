{% extends 'layouts/page.njk' %}

{% from "sortable-paginated-table/macro.njk" import sortablePaginatedTable %}
{% from "search-form/macro.njk" import searchForm %}
{% from "date/macro.njk" import lisDate %}
{% from "not-supplied/macro.njk" import notSupplied %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% block beforeContent %}
  {% if backLinkHref %}
    {{ govukBackLink({
      text: "Back",
      href: backLinkHref
    }) }}
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if isBackOffice %}
        <span class="govuk-caption-l">Holding</span>
        <h1 class="govuk-heading-l">{{ holdingHeading }}</h1>
      {% else %}
        <span class="govuk-caption-l">{{ holdingHeading }}</span>
        <h1 class="govuk-heading-l">Animals on holding</h1>
      {% endif %}

      {{ lisSubNavigation({
        label: "Holding sections",
        items: tabs
      }) }}

      {% if not search and totalItems == 0 %}
        <p class="govuk-body">There are no animals currently registered on your holding.</p>
        <p class="govuk-body">
          If you believe this is incorrect, contact the <a class="govuk-link" href="https://www.gov.uk/government/organisations/british-cattle-movement-service#:~:text=guidance%20and%20regulation-,Contact%20BCMS,-British%20Cattle%20Movement">British Cattle Movement Service (BCMS)</a>.
        </p>
      {% else %}
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-two-thirds">
            {{ searchForm({
              label: "Search animals on holding" if isBackOffice else "Search animals on your holding",
              hint: "You can use all or part of the animal ear tag number, or search by sex or breed.",
              value: search,
              maxlength: 100,
              hiddenFields: [{ name: "referrer", value: referrerId }] if referrerId else undefined,
              insetText: undefined if isBackOffice else "Recent changes such as new registrations may take up to 24 hours to appear in your list."
            }) }}
          </div>
        </div>

        {% if isBackOffice %}
          <p class="govuk-body govuk-!-text-break-word">
            {%- if search -%}
              {{ totalItems }} registered cattle record{{ "s match" if totalItems != 1 else " matches" }} <strong>‘{{ search }}’</strong>
            {%- else -%}
              {{ totalItems }} registered cattle
            {%- endif -%}
          </p>
        {% elif search %}
          <p class="govuk-body govuk-!-text-break-word">
            {{ totalItems }} result{{ "s" if totalItems != 1 else "" }} for <strong>'{{ search }}'</strong>
          </p>
        {% endif %}
        {% if search %}
          <p class="govuk-body">
            <a class="govuk-link" href="{{ clearSearchHref }}">Clear search</a>
          </p>
        {% endif %}

        {% if totalItems > 0 %}
          {% set notSuppliedHtml = notSupplied("N/A") if isBackOffice else notSupplied() %}

          {%- set rows = [] -%}
          {%- for animal in animals -%}
            {%- set breedHtml -%}
              <abbr title="{{ animal.breedName }}">{{ animal.breedCode }}</abbr><span class="govuk-visually-hidden">, {{ animal.breedName }}</span>
            {%- endset -%}
            {%- set eartagHtml -%}
              <a class="govuk-link" href="{{ animalsBasePath }}/{{ animal.eartag }}">{{ animal.eartag | formatEarTag }}</a>
            {%- endset -%}
            {#- no age for a missing, unparseable or future date of birth -#}
            {%- set age = animal.dateOfBirth | formatAge -%}
            {%- set _ = rows.push([
              { html: eartagHtml } if animal.eartag else { html: notSuppliedHtml },
              { text: lisDate(animal.dateOfBirth) } if animal.dateOfBirth else { html: notSuppliedHtml },
              { text: age } if age else { html: notSuppliedHtml },
              { text: lisDate(animal.dateOnCph) } if animal.dateOnCph else { html: notSuppliedHtml },
              { text: animal.sex } if animal.sex else { html: notSuppliedHtml },
              { html: breedHtml } if animal.breedCode else { html: notSuppliedHtml }
            ]) -%}
          {%- endfor -%}

          {{ sortablePaginatedTable({
            caption: "Cattle search results" if isBackOffice else "Animals on holding",
            summary: { text: summaryText, position: "below" } if isBackOffice else undefined,
            classes: "lis-sortable-table--no-wrap",
            firstCellIsHeader: isBackOffice,
            columns: columns,
            rows: rows,
            sort: sort,
            direction: direction,
            baseHref: baseHref,
            pagination: pagination,
            query: { search: search, referrer: referrerId }
          }) }}
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}
