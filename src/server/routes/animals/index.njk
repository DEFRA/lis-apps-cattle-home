{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "not-supplied/macro.njk" import notSupplied %}

{% set notSuppliedHtml = notSupplied() %}
{% set dateFormat = "d MMMM yyyy" if isBackOffice else "d MMM yyyy" %}

{% block beforeContent %}
  {% if backLinkHref %}
    {{ govukBackLink({
      text: "Back",
      href: backLinkHref
    }) }}
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="{{ 'govuk-grid-column-three-quarters' if isBackOffice else 'govuk-grid-column-full' }}">
      {% if isBackOffice %}
        <span class="govuk-caption-l">Registered animal</span>
        <h1 class="govuk-heading-l">{{ formattedEarTag }}</h1>

        <h2 class="govuk-heading-m">Animal details</h2>
      {% else %}
        <span class="govuk-caption-l">{{ formattedEarTag }}</span>
        <h1 class="govuk-heading-l">Cattle details</h1>
      {% endif %}

      {%- set animalRows = [
        {
          key: { text: "Ear tag number" },
          value: { text: formattedEarTag } if cattle.eartag else { html: notSuppliedHtml }
        },
        {
          key: { text: "Date of birth" },
          value: { text: cattle.dateOfBirth | formatDate(dateFormat) } if cattle.dateOfBirth else { html: notSuppliedHtml }
        },
        {
          key: { text: "Registered on" if isBackOffice else "Date registered" },
          value: { text: cattle.dateRegistered | formatDate(dateFormat) } if cattle.dateRegistered else { html: notSuppliedHtml }
        }
      ] -%}
      {%- if not isBackOffice -%}
        {%- set _ = animalRows.push({
          key: { text: "Date on holding" },
          value: { text: cattle.dateOnCph | formatDate(dateFormat) } if cattle.dateOnCph else { html: notSuppliedHtml }
        }) -%}
      {%- endif -%}
      {%- set _ = animalRows.push(
        {
          key: { text: "Sex" },
          value: { text: cattle.sex } if cattle.sex else { html: notSuppliedHtml }
        },
        {
          key: { text: "Breed" },
          value: { text: cattle.breedDisplay } if cattle.breedDisplay else { html: notSuppliedHtml }
        },
        {
          key: { text: "Animal status" },
          value: { text: cattle.status }
        }
      ) -%}

      {{ govukSummaryList({
        rows: animalRows
      }) }}

      <h2 class="govuk-heading-m">Dam details</h2>

      {%- set damRows = [
        {
          key: { text: "Dam type" },
          value: { text: cattle.dam.damType } if cattle.dam.damType else { html: notSuppliedHtml }
        },
        {
          key: { text: "Genetic dam ear tag" },
          value: { text: cattle.dam.geneticDamTag | formatEarTag } if cattle.dam.geneticDamTag else { html: notSuppliedHtml }
        }
      ] -%}
      {%- if cattle.dam.showSurrogateRow -%}
        {%- set _ = damRows.push({
          key: { text: "Surrogate dam ear tag" },
          value: { text: cattle.dam.surrogateTag | formatEarTag }
        }) -%}
      {%- endif -%}

      {{ govukSummaryList({
        rows: damRows
      }) }}

      <h2 class="govuk-heading-m">Sire details</h2>

      {% if cattle.sire.hasDetails %}
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Sire ear tag" },
              value: { text: "Not required" } if cattle.sire.tagNotRequired else { text: cattle.sire.tag | formatEarTag }
            },
            {
              key: { text: "Sire name" },
              value: { text: "Not required" } if cattle.sire.nameNotRequired else { text: cattle.sire.name }
            }
          ]
        }) }}
      {% else %}
        <p class="govuk-body">{{ "No sire details are recorded." if isBackOffice else "No sire details recorded." }}</p>
      {% endif %}

      {% if currentLocation %}
        <h2 class="govuk-heading-m">Current location</h2>

        {%- set addressHtml -%}
          {%- for line in currentLocation.addressLines -%}
            {{ line }}{% if not loop.last %}<br>{% endif %}
          {%- endfor -%}
        {%- endset -%}

        {{ govukSummaryList({
          rows: [
            {
              key: { text: "CPH number" },
              value: { text: currentLocation.cph }
            },
            {
              key: { text: "Address" },
              value: { html: addressHtml } if currentLocation.addressLines.length else { html: notSuppliedHtml }
            },
            {
              key: { text: "Moved to holding on" },
              value: { text: cattle.dateOnCph | formatDate(dateFormat) } if cattle.dateOnCph else { html: notSuppliedHtml }
            }
          ]
        }) }}
      {% endif %}
    </div>
  </div>
{% endblock %}
